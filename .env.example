# STRANGERS INTO FRIENDS - Environment Configuration Example
PORT=3000
NODE_ENV=development

# Authentication & Session Security
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_chars
SESSION_SECRET=replace_with_a_secure_session_secret_key

# Google Sheets Database Bridge (Google Apps Script Web App)
# Deploy google-apps-script/Code.gs as a Web App in your Google Spreadsheet
# Set 'Execute as: Me' and 'Who has access: Anyone'
GOOGLE_SCRIPT_WEBAPP_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec
GOOGLE_SCRIPT_API_SECRET=SIF_SECURE_API_SECRET_2026_CHANGE_IN_PRODUCTION

# Set to true to test locally before deploying Google Apps Script
USE_LOCAL_MOCK_DB=false

# Default Admin Setup
ADMIN_EMAIL=admin@strangersintofriends.com
ADMIN_PASSWORD=AdminSecurePass2026!
