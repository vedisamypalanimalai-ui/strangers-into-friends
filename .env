# STRANGERS INTO FRIENDS - Environment Configuration
PORT=3000
NODE_ENV=development

# Authentication & Session Security
JWT_SECRET=sif_jwt_super_secret_key_8f3d9a1c6e4b2d7e_2026
SESSION_SECRET=sif_session_vault_key_9b2e7a4c1f8d6e3a

# Google Sheets Database Bridge (Google Apps Script Web App)
# 1. Deploy google-apps-script/Code.gs as a Web App in your Google Spreadsheet
# 2. Set 'Execute as: Me' and 'Who has access: Anyone'
# 3. Paste the deployed Web App URL below:
GOOGLE_SCRIPT_WEBAPP_URL=https://script.google.com/macros/s/AKfycbyD_nA8OICyHFLpI9NSJJFjIIpNB0H5vGXoja-rUW1oXXkjSTfK0TnzLtWHLqrWZc6Xkw/exec

# API Secret to authorize requests between Express backend and Apps Script
GOOGLE_SCRIPT_API_SECRET=SIF_SECURE_API_SECRET_2026_CHANGE_IN_PRODUCTION

# Set to true to use built-in local JSON database without requiring Google Sheets setup during local testing
USE_LOCAL_MOCK_DB=false

# Default Superadmin Credentials (created automatically if no admin exists)
ADMIN_EMAIL=admin@strangersintofriends.com
ADMIN_PASSWORD=AdminSecurePass2026!
